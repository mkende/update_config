#!/usr/bin/perl

use strict;
use warnings;

sub load_module {
  my ($m, @args) = @_;
  my $try_load = sub {
    eval "require $m" or return 0;
    $m->import(@args);
    1;
  };
  return 1 if $try_load->();
  system "cpan -i $m" and die "Cannot install module '$m'.\n";
  $try_load->() or die "Cannot load module '$m'.\n";
}

INIT {
  load_module 'Data::Section::Simple', 'get_data_section';
  load_module 'File::Basename', 'dirname';
  load_module 'File::Path', 'make_path';
  load_module 'File::Spec::Functions', 'catfile';
  load_module 'Getopt::Long', 'GetOptions';
  load_module 'Pod::Usage', 'pod2usage';
  load_module 'Text::Diff', 'diff';
}

sub print_usage {
  my ($is_help) = @_;
  pod2usage( { -msg => "update_config: Automatic updates of a linux configuration.\n",
               -verbose => $is_help ? 1 : 0,
               -exitval => $is_help ? 0 : 2,
               -output => $is_help ? \*STDOUT : \*STDERR,
             });
}

use constant START_MARKER => "###AUTO-CONFIG START###\n";
use constant END_MARKER   => "###AUTO-CONFIG END###\n";
use constant DEFAULT_COMMENTS_CHAR => '#';

# Short options can be bundled, but long options are accepted even with
# a single '-' and take precedance over short one.
Getopt::Long::Configure('bundling_override');
# Allow short option to be treated case-insensitively (as long options).
Getopt::Long::Configure('ignore_case_always');
my %flags;
GetOptions(\%flags, 'silent', 'diff|d', 'help|h', 'test|t') or print_usage(0);
print_usage(1) if $flags{help};
print_usage(0) if @ARGV;

## contains(file_name, regex)
## Returns true if one of the line of the named file matches the given regex.
# sub contains {
#   my ($file, $re) = @_;
#   open(my $fh, '<', $file) or die "Cannot open '$file': $!";
#   while (my $l = <$fh>) {
#     return 1 if $l =~ m/$re/;
#   }
#   return 0;
# }

# parse_file_name($file_name)
# Returns a tuple (mode, input_spec, output_spec) where mode is one
# of 'file' ou 'pipe' specifying if the input and output spec will
# be normal file name or a commands that should be executed.
sub parse_file_name {
  my ($raw_path) = @_;
  my @file_part = split ',', $raw_path;
  my $mode = @file_part == 1 ? 'file' : 'pipe';
  die "Invalid file specification: '$raw_path'." if @file_part < 1 || @file_part > 2;
  if (@file_part == 1) {
    my $home_dir=`echo -n ~`;
    my $path = catfile($home_dir, $file_part[0]);
    return ('file', $path, $path);
  } else {
    return ('pipe', @file_part);
  }
}

# Verifies that file contains the given content between the start and end
# markers. Otherwise update the content of the file so that it does.
sub read_content {
  my ($mode, $file, $start_marker, $end_marker) = @_;
  if ($mode eq 'file' and not -e $file) {
    return ('', '', '');
  }
  open (my $fh, ($mode eq 'file' ? '<' : '-|'), $file) or die "Cannot open '$file' for read: $!.\n";
  my $status = 'before';
  my ($before_content, $old_content, $after_content) = ('', '', '');
  while (my $l = <$fh>) {
    if ($status eq 'before' && $l ne $start_marker) {
      $before_content .= $l;
    } elsif ($status eq 'before') {
      $status = 'inside';
    } elsif ($status eq 'inside' && $l ne $end_marker) {
      $old_content .= $l;
    } elsif ($status eq 'inside') {
      $status = 'after';
    } else {
      $after_content .= $l;
    }
  }
  die "Missing closing tag in '$file'.\n" if $status eq 'inside';
  close $fh or die "Unexpected error closing '$file': $!.\n";
  return ($before_content, $old_content, $after_content);
}

sub write_content {
  my ($mode, $file, $content) = @_;
  if ($mode eq 'file') {
    my $dir = dirname($file);
    if (not -e $dir) {
      make_path $dir or die "Cannot create directory '$dir': $!.\n";
    }
  }
  open (my $fh, ($mode eq 'file' ? '>' : '|-'), $file) or die "Cannot open '$file' for write: $!\n";
  print $fh $content;
  close $fh or die "Error writing '$file': $!.\n";
}

sub get_one_file_options {
  my ($file, $conf) = @_;
  if ($$file =~ s/^COMMENTS CHAR\s+(\S+)\s*\n+//) {
    my $default_comments_char = DEFAULT_COMMENTS_CHAR;
    my $new_comments_char = $1;
    $$conf{start_marker} =~ s/$default_comments_char/$new_comments_char/g;
    $$conf{end_marker} =~ s/$default_comments_char/$new_comments_char/g;
    return 1;
  } elsif ($$file =~ s/^POST UPDATE\s+(.+)\n+//) {
    $$conf{post_update} = $1;
    return 1;
  }
  return 0;
}

sub parse_file_conf {
  my ($file) = @_;
  my %conf;
  $file =~ s/\n{2,}$/\n/;
  $file =~ s/^\n+//;
  $conf{start_marker} = START_MARKER;
  $conf{end_marker} = END_MARKER;
  while(get_one_file_options(\$file, \%conf)) {}
  $conf{content} = $file;
  return %conf;
}

my $config_files = get_data_section();
while (my ($file, $content) = each %{$config_files}) {
  my %conf = parse_file_conf($content);
  my ($mode, $in_path, $out_path) = parse_file_name($file);
  my ($before, $old_content, $after) = read_content($mode, $in_path, $conf{start_marker}, $conf{end_marker});
  if ($old_content eq $conf{content}) {
    print "Nothing to do for: $out_path\n" unless $flags{silent};
  } else {
    if ($flags{diff}) {
      my $diff = diff(\$old_content, \$conf{content}, {CONTEXT => 0});
      print "Diff for: $file $diff";
    }
    if (not $flags{test}) {
      write_content($mode, $out_path, $before.$conf{start_marker}.$conf{content}.$conf{end_marker}.$after);
      if ($conf{post_update}) {
        my $cmd = $conf{post_update} =~ s/\$@/$out_path/gr;
        system $cmd;        
      }
    }
    print "Updated: $file\n" unless $flags{silent};
  }
}

__DATA__
