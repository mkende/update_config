#!/usr/bin/env perl

use strict;
use warnings;
use 5.024;
use English;

# Only modules that are in the standard distribution for 5.24. The rests should
# be in the INIT block below.
use File::Basename 'dirname';
use File::Path 'make_path';
use File::Spec::Functions 'catfile';
use FindBin;
use Getopt::Long 'GetOptions';
use Pod::Usage 'pod2usage';

sub print_usage {
  my ($is_help) = @_;
  pod2usage( { -msg => "update_config: Automatic updates of a linux configuration.\n",
               -verbose => $is_help ? 1 : 0,
               -exitval => $is_help ? 0 : 2,
               -output => $is_help ? \*STDOUT : \*STDERR,
             });
}

my %flags;
my @orig_argv;
BEGIN {
  @orig_argv = @ARGV;
  GetOptions(\%flags, 'silent', 'diff', 'help', 'test', 'list', 'root', 'no-root',
             'export', 'dir=s', 'pack') or print_usage(0);
  print_usage(1) if $flags{help};
  print_usage(0) if @ARGV;
  if ($flags{pack} and $0 eq '-') {
    print STDERR "Cannot use --pack if the script is read from the standard input\n";
    exit 1;
  }
}

my $need_sudo = 0;

sub try_load {
  my ($m, @args) = @_;
  eval "require $m" or return 0;
  $m->import(@args);
  return 1;
}

my $has_local_lib = '';

sub load_module {
  my ($m, @args) = @_;
  return 1 if try_load($m, @args);

  # We try to load local::lib if we need to install a module.
  # If we don’t have local::lib, we won’t install it as that might require a
  # sudo and, at that point, that defeats the points of using local::lib in the
  # first place.
  if (!$has_local_lib) {
    $ENV{PERL_MM_USE_DEFAULT} = 1;  # Used so that cpan don’t ask questions.
    # local::lib prints some configuration and exit the program when $0 is '-' (meant for `perl -Mlocal::lib`).
    local $0 = $0 eq '-' ? 'fakename.pl' : $0;
    if (try_load('local::lib')) {
      $has_local_lib = '-I';
      print "Successfully loaded local::lib\n" unless $flags{silent};
      # We try to load the module again, in case it was already installed locally.
      return 1 if try_load($m, @args);
    } else {
      $has_local_lib = ' ';  # true but useless in the command line below.
      print "Failed to load local::lib\n" unless $flags{silent};
    }
  }

  # Now, if we have set-up local::lib these will be installed locally otherwise
  # we try to install them system-wide, which might require the use of sudo.

  if (!$need_sudo) {
    system "cpan ${has_local_lib} -i $m" and $need_sudo = 1;
  }
  if ($need_sudo) {
    system "sudo cpan -i $m" and die "Cannot install module '$m'.\n";
  }
  try_load($m, @args) or die "Cannot load module '$m'.\n";
}

# We try to load and, if necessary, instal non-standard modules.
INIT {
  load_module 'Data::Section::Simple', 'get_data_section';
  load_module 'File::HomeDir';
  load_module 'File::Slurp', 'read_file', 'write_file';
  load_module 'Text::Diff', 'diff';
  load_module 'File::Which';  # Loaded so that config fragments can REQUIRE which('program')
}

use constant DEFAULT_COMMENTS_CHAR => '#';
use constant DEFAULT_GUARD_STRING  => 'AUTO-CONFIG';

sub get_home_dir {
  return File::HomeDir->my_home
  # return `echo -n ~`;
}

# Remove part of a file name that we are ignoring when creating the
# target file (for the moment, only a suffix within bracket).
sub clean_output_path {
  my ($name) = @_;
  return $name =~ s/\s*(?:\[.*\]\s*)$//r;
}
# parse_file_name($file_name)
# Returns a tuple (mode, input_spec, output_spec) where mode is one
# of 'file' or 'pipe' specifying if the input and output spec will
# be normal file name or a commands that should be executed.
# If the file has a prefix in bracket, then it is ignored.
sub parse_file_name {
  # if more logic is added in this function, it may be needed to reverse
  # it in the export block.
  my ($raw_path) = @_;
  $raw_path = clean_output_path($raw_path);
  my @file_part = split ',', $raw_path;
  my $mode = @file_part == 1 ? 'file' : 'pipe';
  die "Invalid file specification: '$raw_path'." if @file_part < 1 || @file_part > 2;
  if (@file_part == 1) {
    my $path;
    if ($file_part[0] =~ m{^/}) {
      $path = $file_part[0];
    } else {
      $path = catfile(get_home_dir(), $file_part[0]);
    }
    return ('file', $path, $path);
  } else {
    return ('pipe', @file_part);
  }
}

# Verifies that file contains the given content between the start and end
# markers. Otherwise update the content of the file so that it does.
sub read_content {
  my ($mode, $file, $conf) = @_;
  if ($mode eq 'file' and not -e $file) {
    return ('', '', '');
  }
  open (my $fh, ($mode eq 'file' ? '<' : '-|'), $file) or die "Cannot open '$file' for read: $!.\n";
  my $status = $$conf{entire_file} ? 'inside' : 'before';
  my ($before_content, $old_content, $after_content) = ('', '', '');
  while (my $l = <$fh>) {
    if ($status eq 'before' && $l ne $$conf{start_marker}) {
      $before_content .= $l;
    } elsif ($status eq 'before') {
      $status = 'inside';
    } elsif ($status eq 'inside' && $l ne $$conf{end_marker}) {
      $old_content .= $l;
    } elsif ($status eq 'inside') {
      $status = 'after';
    } else {
      $after_content .= $l;
    }
  }
  if ($$conf{is_prefix} && $status eq 'before') {
    ($before_content, $after_content) = ('', $before_content);
  }
  die "Missing closing tag in '$file'.\n" if $status eq 'inside' and not $$conf{entire_file};
  close $fh;
  return ($before_content, $old_content, $after_content);
}

sub write_content {
  my ($mode, $file, $content, $conf) = @_;
  if ($mode eq 'file') {
    my $dir = dirname($file);
    if (not -e $dir) {
      make_path($dir) or die "Cannot create directory '$dir': $!.\n";
    }
  }
  open (my $fh, ($mode eq 'file' ? '>' : '|-'), $file) or die "Cannot open '$file' for write: $!\n";
  print $fh $content;
  if ($$conf{make_executable}) {
    my $current_mode = (stat $fh)[2] & 07777;
    chmod($current_mode | 0111, $fh);
  }
  close $fh or die "Error writing '$file': $!.\n";
  chmod oct($$conf{perm}), $file if need_perm_update($file, $mode, $conf);
}

sub need_perm_update {
  my ($file, $mode, $conf) = @_;
  return 0 if not exists $$conf{perm};
  return 0 if $mode ne 'file';
  my $current = (stat $file)[2] & 07777;
  return $current != oct($$conf{perm});
}

sub get_one_file_options {
  my ($file, $conf) = @_;
  if ($$file =~ s/^COMMENTS CHAR\s+(.*?)\s*\n+//) {
    $$conf{comments_char} = $1;
    return 1;
  } elsif ($$file =~ s/GUARD SUFFIX\s+(.*?)\s*\n+//) {
    $$conf{guard_suffix} = $1;
    return 1;
  } elsif ($$file =~ s/^POST UPDATE\s+(.*?)\s*\n+//) {
    $$conf{post_update} = $1;
    return 1;
  } elsif ($$file =~ s/^IS PREFIX\s*\n+//) {
    $$conf{is_prefix} = 1;
    return 1;
  } elsif ($$file =~ s/^NEED ROOT\s*\n+//) {
    $$conf{need_root} = 1;
    return 1;
  } elsif ($$file =~ s/^ENTIRE FILE\s*\n+//) {
    $$conf{entire_file} = 1;
    return 1;
  } elsif ($$file =~ s/^MAKE EXECUTABLE\s*\n+//) {
    $$conf{make_executable} = 1;
    return 1;
  } elsif ($$file =~ s/^REQUIRE\s+(.*?)(?:\s*#\s*(.*))??\n+//) {
    push @{$$conf{require}}, [$1, $2];
    return 1;
  } elsif ($$file =~ s/^FILENAME\s+(.*?)\s*\n+//) {
    $$conf{filename} = $1;
    return 1;
  } elsif ($$file =~ s/^PERM\s+(.*?)\s*\n+//) {
    # TODO: validate that the mode is a correct octal value.
    $$conf{perm} = $1;
    return 1;
  } elsif ($$file =~ s/^REM\s+.*\n+//) {
    return 1;
  }
  return 0;
}

sub parse_file_conf {
  my ($file) = @_;
  my %conf;
  $file =~ s/\n{2,}$/\n/;
  $file =~ s/^\n+//;
  while(get_one_file_options(\$file, \%conf)) {}
  my $comments_decorator = ($conf{comments_char} // DEFAULT_COMMENTS_CHAR) x 3;
  my $guard = DEFAULT_GUARD_STRING . (exists $conf{guard_suffix} ? ':'.$conf{guard_suffix} : '');
  $conf{start_marker} = $comments_decorator.$guard.' START'.$comments_decorator."\n";
  $conf{end_marker} = $comments_decorator.$guard.' END'.$comments_decorator."\n";
  $conf{content} = $file;
  return %conf;
}

# Puts in %$content the content of the files in the given directory and
# all its subdirectories. Ignores hidden files and directories. Ignores
# multiple files with the same name.
sub read_config_files {
  my ($dir, $content) = @_;
  opendir(my $dh, $dir) or die "Can't open dir '$dir': $!\n";
  while (readdir $dh) {
    next if  m/^\./;
    my $f = catfile($dir, $_);
    read_config_files($f, $content) if -d $f;
    $content->{$_} = read_file($f) if -f $f;
  }
  closedir $dh;
}

if ($flags{export}) {
  my $internal_files = get_data_section();
  while (my ($file, $content) = each %{$internal_files}) {
    my %conf = parse_file_conf($content);
    if (not exists $conf{filename}) {
      my $output = clean_output_path($file);
      $content = "FILENAME $output\n$content";
    }
    $file =~ s/^\.//;
    $file =~ s{/|,}{_}g;
    print "Exporting: $file\n";
    write_file($file, $content) or die "Cannot write file '$file': $!\n";
  }
  exit 0;
}

my $config_files = {};
$config_files = get_data_section() unless $flags{pack};  # We don’t read __DATA__ if we’re packing content anyway.
my @config_dirs;
if ($flags{dir}) {
  @config_dirs = ($flags{dir});
} else {
  @config_dirs = (catfile($FindBin::Bin, 'config.d'), catfile(get_home_dir(), '.config/update_config'));
}
for my $d (@config_dirs) {
  next if not -d $d;
  read_config_files($d, $config_files);
}

# We print our own script to STDOUT if we are in --pack mode.
print read_file($FindBin::Script) if $flags{pack};

my $need_root;
FILE: for my $file (sort { (lc $a) cmp (lc $b) } keys %{$config_files}) {
  my $content = $config_files->{$file};
  if ($flags{pack}) {
    printf "@@ %s\n%s\n", $file, $content;
    next;
  }
  my %conf = parse_file_conf($content);
  my $target = $conf{filename} // $file;
  my $display_name = $target . ($conf{guard_suffix} ? ' ('.$conf{guard_suffix}.')' : '');
  for my $r (@{$conf{require}}) {
    if (not eval $r->[0]) {
      die "Error while executing 'require' guard for ${display_name} '$r->[0]': $@.\n" if $@;
      printf "Skipping %s due to require guard%s\n", $display_name, ($r->[1] ? ': '.$r->[1] : '') unless $flags{silent};
      next FILE;
    }
  }
  my ($mode, $in_path, $out_path) = parse_file_name($target);
  if ($flags{list}) {
    print "$in_path\n";
    next;
  }
  my ($before, $old_content, $after) = read_content($mode, $in_path, \%conf);
  if ($old_content eq $conf{content} and not need_perm_update($out_path, $mode, \%conf)) {
    print "Nothing to do for: $display_name\n" unless $flags{silent};
  } else {
    if ($flags{diff}) {
      my $diff = diff(\$old_content, \$conf{content}, {CONTEXT => 0});
      print "Diff for: $display_name\n$diff";
    }
    if ($conf{need_root} and not $flags{root}) {
      $need_root = 1;
      next;
    } elsif ($flags{root} and not $conf{need_root}) {
      next;
    }
    if (not $flags{test}) {
      my $content;
      if ($conf{entire_file}) {
        $content = $conf{content};
      } else {
        $content = $before.$conf{start_marker}.$conf{content}.$conf{end_marker}.$after;
      }
      write_content($mode, $out_path, $content, \%conf);
      if ($conf{post_update}) {
        my $cmd = $conf{post_update} =~ s/\$@/$out_path/gr;
        system $cmd;
      }
    }
    print "Updated: ${display_name}\n" unless $flags{silent};
  }
}

if ($need_root && !$flags{'no-root'}) {
  if ($0 eq '-') {
    print "Skipping NEED_ROOT fragments for an execution from stdin\n" unless $flags{silent};
    exit 0;
  }
  my $script = catfile(${FindBin::RealBin}, ${FindBin::RealScript});
  system('sudo', $script, @orig_argv, '--root');
}

=pod

=head1 SYNOPSIS

update_config [--test] [--help] [--diff] [--silent] [--list]

=head1 OPTIONS

The available options for the program are the following. They can all be
abbreviated down to a single character.

  --diff   Print the difference between the current configuration and what
           will be written
  
  --silent Do not print the status of the configuration files (except for
           error messages).
  
  --test   Do not modify the configuration files.
  
  --list   Only print a list of the configuration files and exit.

  --root   Install only the configuration fragments that are marked as
           'NEED ROOT'.
  
  --no-root  Do not attempt to install the 'NEED ROOT' fragments.

  --export Export in the current directory all the files that are embedded
           in the script.

  --dir directory   Process only the configuration files in the given
           directory and its subdirectories, instead of those from the
           default paths.

  --pack  Write on the standard output a version of the script where all the
          config fragments are embedded. To be used typicaly with:
            update_config --pack | ssh user@host perl -- - --no-root
          or just
            update_config --pack | ssh host perl
  
  --help   Print this help message.

=cut

__DATA__
