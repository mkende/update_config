#!/usr/bin/perl

use strict;
use warnings;

sub print_usage {
  print "$0: Automatic updating of a linux configuration\n";
  exit 0;
}

sub load_module {
  my ($m, @args) = @_;
  my $try_load = sub {
    eval "require $m" or return 0;
    $m->import(@args);
    1;
  };
  return 1 if $try_load->();
  system "cpan -i $m" and die "Cannot install module '$m'.\n";
  $try_load->() or die "Cannot load module '$m'.\n";
}

INIT {
  print_usage if grep { m/^--?h(elp)?$/ } @ARGV;
  load_module 'Data::Section::Simple', 'get_data_section';
  load_module 'File::Basename', 'dirname';
  load_module 'File::Path', 'make_path';
  load_module 'File::Spec::Functions', 'catfile';
  load_module 'Text::Diff', 'diff';
}

use constant START_MARKER => "###AUTO-CONFIG START###\n";
use constant END_MARKER   => "###AUTO-CONFIG END###\n";
use constant DEFAULT_COMMENTS_CHAR => '#';

## contains(file_name, regex)
## Returns true if one of the line of the named file matches the given regex.
# sub contains {
#   my ($file, $re) = @_;
#   open(my $fh, '<', $file) or die "Cannot open '$file': $!";
#   while (my $l = <$fh>) {
#     return 1 if $l =~ m/$re/;
#   }
#   return 0;
# }

sub parse_file_name {
  my ($raw_path) = @_;
  my @file_part = split ',', $raw_path;
  my $mode = @file_part == 1 ? 'file' : 'pipe';
  die "Invalid file specification: '$raw_path'." if @file_part < 1 || @file_part > 2;
  if (@file_part == 1) {
    my $home_dir=`echo -n ~`;
    my $path = catfile($home_dir, $file_part[0]);
    return ('file', $path, $path);
  } else {
    return ('pipe', @file_part);
  }
}

# Verifies that file contains the given content between the start and end
# markers. Otherwise update the content of the file so that it does.
sub read_content {
  my ($mode, $file, $start_marker, $end_marker) = @_;
  if ($mode eq 'file' and not -e $file) {
    return ('', '', '');
  }
  open (my $fh, ($mode eq 'file' ? '<' : '-|'), $file) or die "Cannot open '$file' for read: $!.\n";
  my $status = 'before';
  my ($before_content, $old_content, $after_content) = ('', '', '');
  while (my $l = <$fh>) {
    if ($status eq 'before' && $l ne $start_marker) {
      $before_content .= $l;
    } elsif ($status eq 'before') {
      $status = 'inside';
    } elsif ($status eq 'inside' && $l ne $end_marker) {
      $old_content .= $l;
    } elsif ($status eq 'inside') {
      $status = 'after';
    } else {
      $after_content .= $l;
    }
  }
  die "Missing closing tag in '$file'.\n" if $status eq 'inside';
  close $fh or die "Unexpected error closing '$file': $!.\n";
  return ($before_content, $old_content, $after_content);
}

sub write_content {
  my ($mode, $file, $content) = @_;
  if ($mode eq 'file') {
    my $dir = dirname($file);
    if (not -e $dir) {
      make_path $dir or die "Cannot create directory '$dir': $!.\n";
    }
  }
  #open (my $fh, ($mode eq 'file' ? '>' : '|-'), $file) or die "Cannot open '$file' for write: $!\n";
  #print $fh $content;
  #close $fh or die "Error writing '$file': $!.\n";
  print "$file updated.\n";
}

sub parse_file_conf {
  my ($file) = @_;
  my %conf;
  $file =~ s/\n{2,}$/\n/;
  $file =~ s/^\n+//;
  if ($file =~ s/^COMMENTS CHAR (.)\n+//) {
    $conf{start_marker} = START_MARKER =~ tr/DEFAULT_COMMENTS_CAR/$1/r;
    $conf{end_marker} = END_MARKER =~ tr/DEFAULT_COMMENTS_CAR/$1/r;
  } else {
    $conf{start_marker} = START_MARKER;
    $conf{end_marker} = END_MARKER;
  }
  $conf{content} = $file;
  return %conf;
}

my $config_files = get_data_section();
while (my ($file, $content) = each %{$config_files}) {
  my %conf = parse_file_conf($content);
  my ($mode, $in_path, $out_path) = parse_file_name($file);
  my ($before, $old_content, $after) = read_content($mode, $in_path, $conf{start_marker}, $conf{end_marker});
  if ($old_content eq $content) {
    print "$out_path is up-to-date.\n";
  } else {
    write_content($mode, $out_path, $before.$conf{start_marker}.$conf{content}.$conf{end_marker}.$after);
  }
}

__DATA__
